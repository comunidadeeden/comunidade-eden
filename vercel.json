{
  "rewrites": [
    {
      "source": "/auth/action",
      "destination": "/index.html"
    },
    {
      "source": "/acesso",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/materiais/arquivos/:path*",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ]
}
