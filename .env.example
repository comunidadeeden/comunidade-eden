# This frontend reads Firebase settings from firebase-applet-config.json.
# Keep production secrets out of this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GUARDIAN_SYSTEM_PROMPT=

# Emails transacionais de acesso via Resend.
# Exemplo: RESEND_FROM_EMAIL="Eden <acesso@brunosimplicio.com.br>"
APP_URL=https://comunidadeeden.com.br
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# Opcional: habilita /api/test-access-email para validar envio pela Vercel.
# Remova da Vercel depois do teste se quiser desativar o endpoint.
ACCESS_EMAIL_TEST_SECRET=
