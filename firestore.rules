rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gu.correa98@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasPurchasedExtraContent() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.purchasedOfferIds is list &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.purchasedOfferIds.size() > 0;
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- USERS ---
    function isValidUser(data) {
      return data.keys().hasOnly([
               'uid',
               'name',
               'email',
               'avatar',
	               'points',
	               'role',
	               'requiresPasswordSetup',
	               'isBlocked',
	               'accessExpiresAt',
	               'profession',
               'instagram',
               'phone',
               'birthDate',
               'maritalStatus',
               'hasChildren',
               'childrenCount',
               'lastAudioDate',
               'lastMissionRewardDate',
               'lastAccessAt',
               'isCofounder',
               'completedChallenges',
               'purchasedOfferIds',
               'updatedAt'
             ]) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
	             data.points is int &&
	             data.role in ['admin', 'student'] &&
	             (!('requiresPasswordSetup' in data) || (data.requiresPasswordSetup is bool)) &&
	             (!('isBlocked' in data) || (data.isBlocked is bool)) &&
	             (!('accessExpiresAt' in data) || (data.accessExpiresAt is string)) &&
             (!('profession' in data) || (data.profession is string && data.profession.size() <= 100)) &&
             (!('instagram' in data) || (data.instagram is string && data.instagram.size() <= 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('birthDate' in data) || (data.birthDate is string && data.birthDate.size() <= 20)) &&
             (!('maritalStatus' in data) || (data.maritalStatus is string && data.maritalStatus.size() <= 50)) &&
             (!('hasChildren' in data) || (data.hasChildren is bool)) &&
             (!('childrenCount' in data) || (data.childrenCount is int)) &&
             (!('lastAudioDate' in data) || (data.lastAudioDate is string)) &&
             (!('lastMissionRewardDate' in data) || (data.lastMissionRewardDate is string)) &&
             (!('lastAccessAt' in data) || (data.lastAccessAt is string)) &&
             (!('isCofounder' in data) || (data.isCofounder is bool)) &&
             (!('completedChallenges' in data) || (data.completedChallenges is list && data.completedChallenges.size() <= 500)) &&
             (!('purchasedOfferIds' in data) || (data.purchasedOfferIds is list && data.purchasedOfferIds.size() <= 200)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500));
    }

    function isStudentProfileUpdate() {
	      return incoming().role == existing().role &&
	             incoming().points == existing().points &&
	             incoming().email == existing().email &&
	             incoming().isBlocked == existing().isBlocked &&
	             incoming().accessExpiresAt == existing().accessExpiresAt &&
	             incoming().purchasedOfferIds == existing().purchasedOfferIds &&
	             incoming().diff(existing()).affectedKeys().hasOnly([
               'name',
               'avatar',
               'profession',
               'instagram',
               'phone',
               'birthDate',
               'maritalStatus',
               'hasChildren',
               'childrenCount',
               'lastAccessAt',
               'updatedAt'
             ]);
    }

    function isStudentLastAccessUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['lastAccessAt', 'updatedAt']) &&
             incoming().lastAccessAt is string &&
             incoming().lastAccessAt.size() <= 40;
    }

    function isStudentPasswordSetupFlagUpdate() {
      return incoming().role == existing().role &&
             incoming().points == existing().points &&
             incoming().email == existing().email &&
             existing().requiresPasswordSetup == true &&
             incoming().requiresPasswordSetup == false &&
             incoming().diff(existing()).affectedKeys().hasOnly(['requiresPasswordSetup', 'updatedAt']);
    }

    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      
      allow create: if (
        isAdmin() &&
        isValidUser(incoming()) &&
        incoming().role in ['admin', 'student'] &&
        incoming().points == 0
      ) || (
        isSignedIn() &&
        isOwner(userId) &&
        isValidUser(incoming()) &&
        incoming().role == 'student' &&
        incoming().points == 0
      );
      
      allow update: if (isAdmin() && isValidUser(incoming())) || (
        isOwner(userId) && 
        isValidUser(incoming()) &&
        (
          isStudentProfileUpdate() ||
          isStudentPasswordSetupFlagUpdate() ||
          isStudentLastAccessUpdate()
        )
      );
      allow delete: if isAdmin();
    }

    // --- STUDENT INVITES ---
    function isValidStudentInvite(data) {
	      return data.keys().hasOnly([
	               'email',
	               'name',
	               'phone',
	               'accessExpiresAt',
	               'role',
               'invitedBy',
               'status',
               'createdAt',
               'updatedAt',
               'acceptedBy',
               'acceptedAt'
             ]) &&
	             data.email is string && data.email.size() <= 100 &&
	             data.name is string && data.name.size() <= 100 &&
	             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
	             (!('accessExpiresAt' in data) || (data.accessExpiresAt is string)) &&
             data.role == 'student' &&
             data.status in ['invited', 'accepted'];
    }

    function isInviteAcceptance() {
      return isSignedIn() &&
             existing().email == request.auth.token.email &&
	             incoming().email == existing().email &&
	             incoming().name == existing().name &&
	             incoming().phone == existing().phone &&
	             incoming().accessExpiresAt == existing().accessExpiresAt &&
	             incoming().role == existing().role &&
             incoming().invitedBy == existing().invitedBy &&
             incoming().status == 'accepted' &&
             incoming().acceptedBy == request.auth.uid &&
             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt', 'updatedAt']);
    }

    match /studentInvites/{inviteId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidStudentInvite(incoming());
      allow update: if (isAdmin() && isValidStudentInvite(incoming())) || (isValidStudentInvite(incoming()) && isInviteAcceptance());
      allow delete: if isAdmin();
    }

    // --- TRAILS, MODULES, CONTENTS ---
    match /trails/{trailId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /adminNotifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /contents/{contentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- SETTINGS ---
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- COMMENTS ---
    function isValidComment(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 100 &&
             data.text is string && data.text.size() <= 1000 &&
             data.lessonId is string && data.lessonId.size() <= 128 &&
             data.createdAt == request.time;
    }

    match /comments/{commentId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidComment(incoming());
      allow update, delete: if isAdmin() || (isSignedIn() && isOwner(existing().userId));
    }

    // --- DAILY CHALLENGES (ADMIN ONLY WRITE) ---
    match /dailyChallenges/{date} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /dailyAudios/{date} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /dailyAudioRewards/{rewardId} {
      allow read, write: if isAdmin();
    }

    match /monthlyScores/{scoreId} {
      allow read, write: if isAdmin();
    }

    match /monthlyPointEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /dailyChallengeCompletions/{completionId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /journeyForms/{formId} {
      allow list: if isAdmin() || isSignedIn();
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /dailyCommitmentCompletions/{completionId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
  }
}
